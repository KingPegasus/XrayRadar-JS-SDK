{
  "name": "xrayradar-js",
  "version": "0.2.1",
  "private": true,
  "description": "XrayRadar JavaScript/TypeScript SDK monorepo (Node, Browser, React, Next.js)",
  "scripts": {
    "version": "node scripts/sync-version.mjs",
    "build": "npm run build -w @xrayradar/core && npm run build -w @xrayradar/node && npm run build -w @xrayradar/browser && npm run build -w @xrayradar/react && npm run build -w @xrayradar/nextjs",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "eslint .",
    "audit": "./scripts/security_audit.sh",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KingPegasus/XrayRadar-JS-SDK.git"
  },
  "homepage": "https://rhymesolutions.com/work/xrayradar",
  "bugs": {
    "url": "https://github.com/KingPegasus/XrayRadar-JS-SDK/issues"
  },
  "author": {
    "name": "Rhyme Solutions",
    "url": "https://rhymesolutions.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
